{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"intelephense.files.associations": [
			"*.php",
			"*.phtml",
			"_ide_helper.php",
			"_ide_helper_models.php",
			"_ide_helper_traits.php",
			".phpstorm.meta.php"
		],
		"intelephense.format.spaceAfterControlStructureKeyword": true,
    	"intelephense.format.spaceAfterFunctionKeyword": true,
		"intelephense.format.spaceAfterArrowFunctionKeyword": true,
		"editor.defaultFormatter": "msamgan.laravel-pint-vscode",
		"toggleexcludedfiles.statusBar.enabled": false,
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		"phpunit.phpunit": "vendor/bin/pest",
		"postman.settings.dotenv-detection-notification-visibility": false
	}
}