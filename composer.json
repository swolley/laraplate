{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "swolley/laraplate",
  "vendor": "swolley",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "version": "v1.13.7",
  "keywords": [
    "laravel",
    "laraplate",
    "framework"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/swolley/license-compliance-checker.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.5",
    "coolsam/modules": "^5.1",
    "joshbrw/laravel-module-installer": "^2.0.1",
    "laravel/framework": "^12.59",
    "laravel/sanctum": "^4.3.2",
    "laravel/tinker": "^2.11.1",
    "nwidart/laravel-modules": "^12.0.5",
    "symfony/http-client": "^7.4.9",
    "filament/filament": "^5.6.3",
    "neuron-core/neuron-ai": "^3.4.6",
    "php-ffmpeg/php-ffmpeg": "^1.4",
    "spatie/laravel-medialibrary": "^11.22.1",
    "spatie/eloquent-sortable": "^4.5.2",
    "staudenmeir/laravel-adjacency-list": "^1.25.2",
    "doctrine/dbal": ">=4.4.3",
    "laravel/fortify": "^1.36.2",
    "hedii/laravel-gelf-logger": "^10.1",
    "lab404/laravel-impersonate": "^1.7.8",
    "overtrue/laravel-versionable": "^5.5",
    "spatie/laravel-permission": "^6.25",
    "laravel/socialite": "^5.27",
    "stephenlake/laravel-approval": "^1.1.4",
    "elasticsearch/elasticsearch": "^8.19",
    "laravel/horizon": "^5.46",
    "typesense/typesense-php": "^5.2",
    "laravel/scout": "^10.25",
    "matanyadaev/laravel-eloquent-spatial": "^4.7",
    "livewire/livewire": "^4.3",
    "filament/spatie-laravel-media-library-plugin": "^5.6.3",
    "spatie/fork": "^1.2.7",
    "yajra/laravel-oci8": "^12.11"
  },
  "require-dev": {
    "swolley/license-compliance-checker": "dev-master",
    "fakerphp/faker": "^1.24.1",
    "laravel/sail": "^1.59",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "php artisan ide-helper:generate",
      "php artisan ide-helper:models -MN",
      "php artisan ide-helper:meta"
    ],
    "check": "vendor/bin/phpstan analyse --memory-limit=2G -v",
    "fix": "vendor/bin/phpstan analyse --memory-limit=2G -v --fix",
    "refactor": "rector",
    "test:type-coverage": [
      "Composer\\Config::disableProcessTimeout",
      "php -d memory_limit=2G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:typos": "peck",
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run"
    ],
    "test:coverage": "pest --parallel --coverage --exactly=100",
    "test:unit": "php artisan test --compact --testsuite=Unit",
    "test:integration": "php artisan test --compact --testsuite=Integration",
    "test:feature": "php artisan test --compact --testsuite=Feature",
    "test:modules": [
      "@test:unit",
      "@test:integration",
      "@test:feature"
    ],
    "test:types": "phpstan",
    "test:refactor": "rector",
    "test:licenses": "@php vendor/bin/check-licenses",
    "test": [
      "@test:type-coverage",
      "@test:coverage",
      "@test:modules",
      "@test:lint",
      "@test:types",
      "@test:refactor",
      "@test:licenses"
    ],
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ],
    "version": "./scripts/version.sh --nointeractive",
    "version:silent": "./scripts/version.sh --silent --nointeractive",
    "version:major": "./scripts/version.sh major",
    "version:minor": "./scripts/version.sh minor",
    "version:patch": "./scripts/version.sh patch",
    "setup:hooks": "./scripts/setup-hooks.sh",
    "update-all": "./scripts/update-composer.sh"
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "barryvdh/laravel-ide-helper"
      ]
    },
    "merge-plugin": {
      "include": [
        "composer.*.json",
        "Modules/*/composer.json"
      ],
      "recurse": true,
      "replace": false,
      "ignore-duplicates": true,
      "merge-dev": true,
      "merge-extra": true,
      "merge-extra-deep": true,
      "merge-replace": true,
      "merge-scripts": true,
      "merge-config": [
        "platform"
      ]
    },
    "installer-paths": {
      "Modules/{$name}/": [
        "type:module"
      ]
    }
  },
  "config": {
    "process-timeout": 7200,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "joshbrw/laravel-module-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
