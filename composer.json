{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "swolley/laraplate",
    "vendor": "swolley",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "version": "v1.8.2",
    "keywords": [
        "laravel",
        "laraplate",
        "framework"
    ],
    "authors": [
        {
            "name": "Swolley",
            "email": "myentity@inwind.it"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "filament/filament": "^3.3",
        "joshbrw/laravel-module-installer": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "^12.0",
        "spatie/fork": "^1.2",
        "symfony/http-client": "^7.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.1",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/phpinsights": "^2.13",
        "peckphp/peck": "^0.1.3",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-stressless": "^3.1",
        "pestphp/pest-plugin-type-coverage": "^3.5",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "lint": [
            "pint",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:models -MN",
            "php artisan ide-helper:meta"
        ],
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --exactly=100",
        "test:typos": "peck",
        "test:lint": "pint --test",
        "test:unit": "pest --parallel --coverage --exactly=100",
        "test:types": "phpstan --memory-limit=2G",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:type-coverage",
            "@test:typos",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:refactor"
        ],
        "version": "./scripts/version.sh --nointeractive",
        "version:silent": "./scripts/version.sh --silent --nointeractive",
        "version:major": "./scripts/version.sh major",
        "version:minor": "./scripts/version.sh minor",
        "version:patch": "./scripts/version.sh patch",
        "setup:hooks": "./scripts/setup-hooks.sh",
        "update-all": "./scripts/update-composer.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.*.json",
                "Modules/*/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": true
        },
        "installer-paths": {
            "Modules/{$name}/": [
                "type:module"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "joshbrw/laravel-module-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
