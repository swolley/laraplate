{
    "name": "swolley/laravel-boilerplate",
    "version": "2.2.0",
    "vendor": "swolley",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "authors": [
        {
            "name": "Swolley",
            "email": "myentity@inwind.it"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-redis": "*",
        "algolia/algoliasearch-client-php": "^3.4",
        "amphp/amp": "^3.0",
        "doctrine/dbal": "*",
        "hedii/laravel-gelf-logger": "^9.0",
        "jeroen-g/explorer": "^3.14",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/fortify": "^1.21",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.9",
        "laravel/tinker": "^2.9",
        "nextapps/laravel-swagger-ui": "^0.9.2",
        "nwidart/laravel-modules": "^11.0",
        "overtrue/laravel-versionable": "^5.2",
        "spatie/laravel-permission": "^6.4",
        "staudenmeir/laravel-adjacency-list": "*",
        "stephenlake/laravel-approval": "^1.1",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "tymon/jwt-auth": "^2.1",
        "wikimedia/composer-merge-plugin": "*"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "mtrajano/laravel-swagger": "^0.6.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models -MN",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "check": "vendor/bin/phpstan analyse --memory-limit=2G -v",
        "lint": [
            "vendor/bin/pint --dirty"
        ],
        "changelog": "conventional-changelog",
        "release": "conventional-changelog --commit",
        "release:patch": "conventional-changelog --patch --commit",
        "release:minor": "conventional-changelog --minor --commit",
        "release:major": "conventional-changelog --major --commit"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        },
        "ramsey/conventional-commits": {
            "config": {
                "types": [
                    "chore",
                    "docs",
                    "style",
                    "refactor",
                    "perf",
                    "test",
                    "config",
                    "merge"
                ],
                "scopeRequired": true
            }
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ],
            "recurse": false,
            "replace": true,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": true
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "captainhook/plugin-composer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
