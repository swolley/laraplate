{
    "name": "swolley/laraplate",
    "vendor": "swolley",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "version": "1.2.3",
    "keywords": [
        "laravel",
        "laraplate",
        "framework"
    ],
    "authors": [
        {
            "name": "Swolley",
            "email": "myentity@inwind.it"
        }
    ],
    "license": "MIT",
    "require": {
        "joshbrw/laravel-module-installer": "^2.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "nwidart/laravel-modules": "^11.0",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "tymon/jwt-auth": "^2.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "driftingly/rector-laravel": "^1.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.26",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest-plugin-faker": "^3.0",
        "rector/rector": "^1.2",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan module:composer-update -a",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models -MN",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "check": "vendor/bin/phpstan analyse --memory-limit=2G -v",
        "lint": [
            "vendor/bin/pint --dirty"
        ],
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "test:parallel": "pest --parallel",
        "version:major": "./scripts/version.sh major",
        "version:minor": "./scripts/version.sh minor",
        "version:patch": "./scripts/version.sh patch",
        "setup:hooks": "./scripts/setup-hooks.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.*.json",
                "Modules/*/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": true
        },
        "installer-paths": {
            "Modules/{$name}/": [
                "type:module"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "joshbrw/laravel-module-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
