includes:
    # The 9.851 errors that existed on 2026-09-17, frozen so new ones fail the run.
    # This is not a list of things that are fine: it is the debt, made visible and
    # kept from growing. Shrink it by category (see the notes in ignoreErrors) and
    # regenerate; never add to it to silence something new.
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    # Analysis level (0-9, max = 9)
    level: 9

    tmpDir: /tmp/phpstan
    
    # Directories to analyze
    paths:
        - app/
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - Modules/
    
    # Files to exclude
    excludePaths:
        # Exclude only the main _ide_helper.php file (generated by barryvdh/laravel-ide-helper)
        - _ide_helper.php (?)
        - .phpstorm.meta.php (?)
        # Exclude vendor files that may cause issues
        - vendor/**
        - storage/*
        - bootstrap/cache/*
        # Module test suites. PHPStan cannot read Pest's DSL without
        # pestphp/pest-plugin-phpstan, which is not installed (its include is
        # commented out at the top of this file). Without it the suites reported
        # 23.067 of the 33.282 errors, 11.793 of them the single identifier
        # method.internalClass: every `expect(...)->toBe(...)` call in the project,
        # read as reaching into Pest's internals. They are artefacts of the missing
        # extension, not defects. Delete these two lines when the plugin is installed.
        - Modules/*/tests/*
        - Modules/*/tests/**
        # SentenceTransformersEmbeddingGenerator implements an interface from LLPhant,
        # a package this application does not depend on (no llphant entry in
        # composer.json) and cannot autoload. Nothing references the class either, so
        # it is dead code left behind by a dependency that went away. `interface.notFound`
        # is not ignorable, so the file leaves the analysis instead. Delete the file and
        # this exclusion goes with it.
        - Modules/Core/app/Search/Ai/SentenceTransformersEmbeddingGenerator.php
        # Two files under Modules/Core/stubs are App-side templates used only by the
        # test suite; one deliberately extends a final class, which works there because
        # BypassFinals is active and is an error to report anywhere else.
        - Modules/*/stubs/*
        - Modules/*/stubs/**
    
    # Ignore specific errors
    ignoreErrors:
        # - '#Call to an undefined method [a-zA-Z0-9\\_]+::shouldReceive\(\)#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::name\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::withoutMiddleware\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::can\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::where\(\).$#'
        # - '#Call to an undefined static method Illuminate\\Database\\Eloquent\\Model::withTrashed\(\).$#'
        # - '#Call to an undefined static method Illuminate\\Database\\Eloquent\\Model::getTimestampColumns\(\).$#'
        # - '#Call to an undefined method Modules\\Core\Grids\\Casts\\GridRequestData|Modules\\Core\\Grids\\Requests\\GridRequest::getMethod\(\).$#'
        # - '#Call to an undefined method Illuminate\\Http\\Request::getMethod\(\).$#'
        # Ignore errors related to methods from the HasValidations and HasPermissions traits
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::shouldSkipValidation\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::validateWithRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::getRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::getOperationRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Foundation\\Auth\\User::isSuperAdmin\(\)#'
        # - '#Call to an undefined method Illuminate\\Foundation\\Auth\\User::hasPermission\(\)#'
        - 
          message: "#Called 'env' outside of the config directory which returns null when the config is cached, use 'config'.$#"
          identifier: larastan.noEnvCallsOutsideOfConfig
          path: Modules/*/config/*
        # - '#Static call to instance method __construct\(\)#'
        # Eloquent columns read off a model. The models carry no @property docblocks
        # (the generated ones were dropped on 2026-09-16) and Larastan cannot infer
        # the schema here: databaseMigrationsPath was measured and changed nothing,
        # because the migrations name their tables through enums (ERPTables::Invoices)
        # and build columns through helpers (MigrateUtils::timestamps).
        #
        # This covers 1.790 of the 1.910 reports, all of them the same fact: a column
        # exists in the database and nowhere in the type system. It is scoped to
        # properties whose owner sits under a \Models\ namespace, so an undefined
        # property on a service, a Filament page or a vendor class is still reported
        # (120 of those remain, and they are the ones worth reading).
        #
        # The cost: a genuinely misspelled column on a model is now silent. Restoring
        # `ide-helper:models --write` would let this rule go.
        -
          identifier: property.notFound
          message: '#^Access to an undefined property [\w\\]+\\Models\\[\w\\]+::\$\w+\.$#'
        # Same fact, written by PHPStan as a union or an intersection: a narrowing
        # `instanceof A || instanceof B` leaves `A|B`, and a relation carrying pivot
        # data leaves `Release&object{pivot: Pivot}`. The owner is still a model and
        # the property is still a column, so the rule above has to accept both shapes
        # or the pattern would only cover the case where one class survives narrowing.
        -
          identifier: property.notFound
          message: '#^Access to an undefined property [\w\\]+\\Models\\[\w\\]+(&object\{[^}]*\})?(\|[\w\\]+\\Models\\[\w\\]+(&object\{[^}]*\})?)*::\$\w+\.$#'
        # HasBenchmark is analysed once per command that uses it, and the ?? on the
        # Oracle branch resolves differently depending on the context. The baseline
        # cannot pin a count that moves, so the error is named here instead.
        -
          identifier: nullCoalesce.expr
          path: Modules/Core/app/Console/Concerns/HasBenchmark.php
        -
          identifier: nullCoalesce.expr
          path: Modules/Core/app/Overrides/Command.php
        # Both engines are analysed in more than one context, and this error appears in
        # some and not others. A baseline entry pins a count, and a count that moves is
        # reported as ignore.count, so these two are named here without one.
        -
          identifier: function.alreadyNarrowedType
          path: Modules/Core/app/Search/Engines/ElasticsearchEngine.php
        -
          identifier: function.alreadyNarrowedType
          path: Modules/Core/app/Search/Engines/TypesenseEngine.php
        # Laravel Scout - methods added by the Searchable trait
        - '#Call to an undefined method.*::searchableAs\(\)#'
        # Cache::remember with an array as TTL (likely a bug, but ignore for now)
        - '#Parameter.*\$ttl.*Cache::remember.*array given#'
        -
          message: '#Property Modules\\CMS\\Models\\Pivot\\Categorizable::\$primaryKey \(string\) does not accept default value#'
          path: Modules/CMS/app/Models/Pivot/Categorizable.php
        # Carried over from the module phpstan.neon files when the toolchain was centralized
        # (2026-09-15). Their paths were module-relative; they are prefixed here.
        -
            identifier: generics.lessTypes
            path: Modules/*/app/Models
        -
            identifier: return.type
            path: Modules/*/app/Models
        -
            identifier: property.onlyWritten
            path: Modules/CMS/app/Models/Content.php
        -
            identifier: property.onlyWritten
            path: Modules/CMS/app/Models/Pivot/Fieldable.php
        -
            identifier: return.unusedType
            path: Modules/CMS/app/Models/Tag.php
        -
            identifier: return.unusedType
            path: Modules/CMS/app/Models/Contributor.php
        -
            identifier: new.staticInAbstractClassStaticMethod
            path: Modules/CMS/app/Services/Contracts/AbstractGeocodingService.php
        -
            identifier: new.static
            path: Modules/CMS/app/Services/Contracts/AbstractGeocodingService.php
        -
            identifier: return.type
            path: Modules/CMS/app/Services/Contracts/AbstractGeocodingService.php
        -
            identifier: method.notFound
            path: Modules/CMS/app/Helpers/HasMedia.php
        -
            identifier: arguments.count
            path: Modules/AI/app/Listeners/*
    # Do not report unmatched patterns (to avoid warnings on IDE helper files)
    reportUnmatchedIgnoredErrors: false

    # Laravel configuration
    checkModelProperties: true
    checkOctaneCompatibility: true
    noEnvCallsOutsideOfConfig: true
    checkModelAppends: true