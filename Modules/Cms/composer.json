{
    "name": "swolley/laraplate-cms",
    "description": "CMS Module contains all the necessary functionalities for build up a new CMS system.",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "laraplate",
        "cms"
    ],
    "authors": [
        {
            "name": "Swolley",
            "email": "myentity@inwind.it"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-imagick": "*",
        "spatie/laravel-tags": "^4.7",
        "tightenco/parental": "^1.4",
        "spatie/laravel-medialibrary": "^11.11",
        "php-ffmpeg/php-ffmpeg": "^1.3"
    },
    "suggest": {
        "ext-gd": "Instead of php-imagick for image processing",
        "ext-imagick": "Instead of php-gd for image processing"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Cms\\": "app/",
            "Modules\\Cms\\Database\\Factories\\": "database/factories/",
            "Modules\\Cms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Cms\\Tests\\": "tests/"
        }
    }
}
